# Copy to .env and adjust. Docker Compose picks it up automatically when you
# run `docker compose` from this directory.
#
#   cp .env.example .env
#
# .env is gitignored, .env.example is not.

# Absolute path to the ROM library, one folder per system (nes/, snes/, psx/, ...).
# Point it at a folder on the USB drive, mounted at a fixed path through
# /etc/fstab (see README.md). Mounted read-only inside the container.
# Defaults to ./data/roms when unset.
ROMS_DIR=/mnt/games/roms

# Same for BIOS files, one folder per system (psx/scph5501.bin, ...).
# Defaults to ./data/bios when unset.
BIOS_DIR=/mnt/games/bios

# Timezone
TZ=Europe/Lisbon
