# Copy to .env and adjust. Docker Compose picks it up automatically when you
# run `docker compose` from this directory.
#
#   cp .env.example .env
#
# .env is gitignored, .env.example is not — keep secrets out of this file.

# Absolute path to the music library on the Pi. Mounted read-only at /music
# inside the container, so Navidrome can never modify the originals.
# Examples: /mnt/music, /srv/media/music, /media/usb-hdd/Music
MUSIC_DIR=/mnt/music

# Timezone, used for scan schedules and timestamps in the UI.
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Lisbon

# User and group the container runs as. These must be able to read MUSIC_DIR
# and write ./data. Run `id -u` and `id -g` on the Pi; the default `pi` user
# is 1000:1000.
PUID=1000
PGID=1000

# Port the web UI and Subsonic API listen on, on the host.
NAVIDROME_PORT=4533
